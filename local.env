# Database
DB_USER=pguser
DB_PASSWORD=pgpass
DB_NAME=dev
DB_HOST=pg
DB_PORT=5432
DB_DRIVER=postgres
DB_SSLMODE=disable
DATABASE_URI=postgres://pguser:pgpass@pg:5432/dev?sslmode=disable

# HTTP Server
SERVER_ADDR=localhost
SERVER_PORT=9000
RUN_ADDRESS=localhost:9000
ACCRUAL_SYSTEM_ADDRESS=http://localhost:8080
BODY_LIMIT_MB=10

# JWT
JWT_SECRET=secret
JWT_ENCRYPTION=1D5494663CE91BAC866DD760C52C848A # 32-bit hex encryption key
JWT_EXPIRE=12